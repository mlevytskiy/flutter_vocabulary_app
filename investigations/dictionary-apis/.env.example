# Copy to .env (gitignored) and fill in the keys you have. Never commit .env.
# Keyless providers (dictionaryapi.dev, Datamuse, Wiktionary REST) need nothing here.

# Self-serve, instant
MERRIAM_WEBSTER_KEY=
OXFORD_APP_ID=
OXFORD_APP_KEY=
WORDSAPI_KEY=
API_NINJAS_KEY=
# Datamuse: keyless today; a key becomes required from 2027
DATAMUSE_KEY=

# MANUAL APPROVAL — apply well in advance, access is not instant
CAMBRIDGE_KEY=
COLLINS_KEY=
