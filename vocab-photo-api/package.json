{
  "name": "vocab-photo-api",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker proxy that sends a photo to Claude and returns extracted English vocabulary + translations.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json",
    "test": "node scripts/test.mjs",
    "test:long": "VOCAB_API_LONG_TESTS=1 node scripts/test.mjs test/rows.test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "wrangler": "^4.127.1",
    "@cloudflare/workers-types": "^5.20260829.1"
  }
}
